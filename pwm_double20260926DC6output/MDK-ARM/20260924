/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

    
    

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  MX_USART1_UART_Init();
  MX_TIM8_Init();
  /* USER CODE BEGIN 2 */
  Stop_PWM();
	TIM2->ARR = 41999;   // 只写一次
	HAL_UARTEx_ReceiveToIdle_DMA(&huart1, rx_buf, RX_BUF_SIZE);// 启动 UART DMA 接收（循环或单次均可，这里用单次+IDLE）
	__HAL_DMA_DISABLE_IT(huart1.hdmarx, DMA_IT_HT);// 禁用 DMA 半传输中断，避免在帧中间触发回调
  
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
 
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
      if(rx_done)
    {
			rx_done = 0; // 先清标志，防止重入
			if (rx_len >= FRAME_LEN)
			{
				
			  int t0 = PARSE(rx_buf, 3),  t1 = PARSE(rx_buf, 9),  t2 = PARSE(rx_buf, 15);
				int t3 = PARSE(rx_buf, 21), t4 = PARSE(rx_buf, 27), t5 = PARSE(rx_buf, 33);
				__disable_irq(); 
				a0_amp=t0; a1_amp=t1; a2_amp=t2; a3_amp=t3; a4_amp=t4; a5_amp=t5;
				__enable_irq();
     
				if (!pwm_started)
				{
						Start_PWM();
						pwm_started = 1;
				}
				tx_buf[0]=rx_buf[3]; 
				tx_buf[1]=rx_buf[4]; 
				tx_buf[2]=rx_buf[9]; 
				tx_buf[3]=rx_buf[10];
				tx_buf[4]=rx_buf[15]; 
				tx_buf[5]=rx_buf[16]; 
				tx_buf[6]=rx_buf[21]; 
				tx_buf[7]=rx_buf[22]; 
				tx_buf[8]=rx_buf[27]; 
				tx_buf[9]=rx_buf[28]; 
				tx_buf[10]=rx_buf[33];
				tx_buf[11]=rx_buf[34]; 
				if (huart1.gState == HAL_UART_STATE_READY)
				{
						HAL_UART_Transmit_DMA(&huart1, tx_buf, 12);
				}			
			}   
    }  
  }
  /* USER CODE END 3 */
}

