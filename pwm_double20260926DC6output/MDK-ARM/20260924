/* USER CODE BEGIN PD */
#define RX_BUF_SIZE 64 
#define FRAME_LEN 37 // "a0:00,a1:00,a2:00,a3:00,a4:00,a5:00\r\n"
#define CLAMP(v, lo, hi)  ((v)<(lo) ? (lo) : ((v)>(hi) ? (hi) : (v)))
#define PARSE(buf, idx)   CLAMP(((buf)[idx]-'0')*10 + ((buf)[(idx)+1]-'0'), 0, 100)
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */


	
